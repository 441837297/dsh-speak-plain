{
  "name": "dsh-speak-plain",
  "version": "0.3.1",
  "description": "DSH 最终回答自动润色：用你选的模型把回答说清楚，保留原文。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "llm",
    "polish",
    "plain-language",
    "rewrite",
    "genui"
  ],
  "author": "Exception-H (Nycto)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exception-H/dsh-speak-plain.git"
  },
  "homepage": "https://github.com/Exception-H/dsh-speak-plain#readme",
  "bugs": {
    "url": "https://github.com/Exception-H/dsh-speak-plain/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/engine.js && node --check src/service.js",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@changfenhuang/dsh-genui": "0.12.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
